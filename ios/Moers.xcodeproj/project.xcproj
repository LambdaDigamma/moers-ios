  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/LambdaDigamma/BulletinBoard",
      "version": {
        "up-to-next-major-version": "6.1.1",
