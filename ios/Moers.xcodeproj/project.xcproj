  "targets": [
    {
      "name": "Prepare Fuel Configuration",
      "id": "0170452FD05F49069653F80C",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Prepare Fuel API Key",
          "log-environment-variables": true,
          "output-paths": [
            "$(SRCROOT)/Moers/Resources/Tankerkoenig-Info.plist",
          ],
          "shell": "/bin/sh",
          "script": [
            "CONFIG_FILE_BASE_NAME=\"Tankerkoenig-Info\"",
            "",
            "CONFIG_FILE_NAME=${CONFIG_FILE_BASE_NAME}.plist",
            "SAMPLE_CONFIG_FILE_NAME=${CONFIG_FILE_BASE_NAME}-Sample.plist",
            "",
            "CONFIG_FILE_PATH=$SRCROOT/Moers/Resources/$CONFIG_FILE_NAME",
            "SAMPLE_CONFIG_FILE_PATH=$SRCROOT/Moers/Resources/$SAMPLE_CONFIG_FILE_NAME",
            "",
            "if [ -f \"$CONFIG_FILE_PATH\" ]; then",
            "  echo \"$CONFIG_FILE_PATH exists.\"",
            "else",
            "  echo \"$CONFIG_FILE_PATH does not exist, copying sample\"",
            "  cp -v \"${SAMPLE_CONFIG_FILE_PATH}\" \"${CONFIG_FILE_PATH}\"",
            "fi",
            "",
          ],
        },
      ],
    }, {
      "name": "Moers",
      "id": "DF1A495E1F6AAB7000E9108B",
      "product": "Products/Moers.app",
      "product-type": "application",
      "last-swift-migration": "10.2",
      "specialized-configurations": [
        { "name": "Debug (Production)", "file": { "anchor": "Moers", "relative-path": "Config/Production.xcconfig" } },
        { "name": "Release (Production)", "file": { "anchor": "Moers", "relative-path": "Config/Production.xcconfig" } },
      ],
      "dependencies": [
        "Prepare Fuel Configuration",
        "WidgetsExtension",
        "Intent Extensions",
      ],
      "build-phases": [
        "frameworks",
        "compile-sources",
        {
          "kind": "script",
          "name": "Settings Bundle Preparation",
          "log-environment-variables": true,
          "input-file-list-paths": [
            "$(SRCROOT)/scripts/settings-bundle-inputs.xcfilelist",
          ],
          "output-file-list-paths": [
            "$(SRCROOT)/scripts/settings-bundle-outputs.xcfilelist",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "/usr/bin/python3 \"$SRCROOT/scripts/prepare-settings-bundle.py\" prepare \\",
            "  --template \"$SRCROOT/Moers/Resources/$MOERS_SETTINGS_BUNDLE_VARIANT/Settings.bundle\" \\",
            "  --licenses \"$SRCROOT/Moers/Resources/Debug/Settings.bundle\" \\",
            "  --info-plist \"$INFOPLIST_FILE\" \\",
            "  --output \"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/Settings.bundle\"",
            "",
          ],
        },
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Lint with SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "#if which swiftlint >/dev/null; then",
            "#   swiftlint",
            "#else",
            "#   echo \"warning: SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "#fi",
            "",
          ],
        },
      ],
